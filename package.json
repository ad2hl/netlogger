{
  "name": "netlogger",
  "version": "0.1.0",
  "private": true,
  "main": "electron/dist/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "electron:compile": "tsc -p electron/tsconfig.json",
    "electron:dev": "cross-env NEXT_PUBLIC_DESKTOP_MODE=true concurrently \"next dev\" \"wait-on http://localhost:3000 && cross-env NEXT_PUBLIC_DESKTOP_MODE=true ELECTRON_DEV=1 electron electron/dist/main.js\"",
    "electron:build": "cross-env NEXT_PUBLIC_DESKTOP_MODE=true next build && npm run electron:compile && electron-builder"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "dexie": "^4.3.0",
    "firebase": "^12.8.0",
    "firebase-admin": "^13.8.0",
    "firebase-tools": "^15.15.0",
    "next": "^15.5.15",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^41.2.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.4",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "net.ad2hl.netlogger-desktop",
    "productName": "AD2HL Net Logger",
    "files": [
      ".next/standalone/**",
      ".next/static/**",
      "public/**",
      "content/**",
      "electron/dist/**"
    ],
    "extraResources": [
      {
        "from": ".next/static",
        "to": ".next/static"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
